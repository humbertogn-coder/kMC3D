#!/bin/bash
#SBATCH --job-name=kmc3d_shuttle
#SBATCH --time=36:00:00
#SBATCH --signal=B:USR1@300
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --array=0-4
#SBATCH --output=slurm_logs/kmc3d_shuttle.%A_%a.out
#SBATCH --error=slurm_logs/kmc3d_shuttle.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=humbertogn@tamu.edu
# ---------------------------------------------------------------------------
# PRODUCTION run of the Li-S shuttle case, multi-seed ensemble.
# Each array task runs ONE seed in its own folder, single core: parallelism
# is across seeds, never inside a run.
#
# Submit from the repository root (the folder that contains kmc3d/):
#     cd /scratch/user/humbertogn/kmc3d
#     mkdir -p slurm_logs
#     sbatch slurm/goKMC_prod_array.slrm                          # default case
#     sbatch --export=ALL,CASE=cases/fullcell_cei slurm/goKMC_prod_array.slrm
# CASE selects the input deck (default cases/fullcell_shuttle); BASE_SEED the
# first seed (default 8597); each array task adds its index to it.
#
# Cost per seed: 200 half-cycles x maxInterval 400 took > 24 h on GRACE
# (killed at cycle 160 to 180), hence --time 36:00:00. With maxInterval 1000
# raise it further (max 7 days on the medium partition). checkpointEveryCycles
# 20 allows resuming: resubmit the same array and every task restarts from its
# checkpoint; cycle_stats.csv is flushed at every checkpoint as well.
#
# Clean shutdown: SLURM delivers the time-limit signal to the batch shell, not
# reliably to a foreground python child. --signal=B:USR1@300 sends USR1 to
# this shell 5 min before the limit; the trap below forwards SIGTERM to python,
# whose handler flushes the ledger and a final checkpoint (run.py).
# IMPORTANT: bash's `wait` returns as soon as the trap runs, BEFORE python has
# exited. If the script then ends, SLURM kills python while it is still writing
# (run 1, 2026-09-23: 0-byte cycle_stats.csv, log not flushed, jobs reported
# COMPLETED 5 min before the limit). The wait loop below keeps the shell alive
# until python has really exited.
# ---------------------------------------------------------------------------
module purge
module load GCCcore/13.2.0
module load Python/3.11.5
source /scratch/user/humbertogn/ase_env/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1

python -c "import sys, numpy; print(sys.version.split()[0], '| numpy', numpy.__version__)"

BASE="$SLURM_SUBMIT_DIR"          # repository root
cd "$BASE"

CASE="${CASE:-cases/fullcell_shuttle}"
BASE_SEED="${BASE_SEED:-8597}"
echo "case=$CASE  base_seed=$BASE_SEED"
SEED=$(( BASE_SEED + SLURM_ARRAY_TASK_ID ))
RUNDIR="$CASE/runs/seed_${SEED}"
mkdir -p "$RUNDIR"

# Inputs are copied and the seed is set ONLY on a fresh start. On resume
# (checkpoint present) the inputs are left untouched.
if [ -f "$RUNDIR/checkpoint.npz" ]; then
    echo "seed $SEED: resuming from checkpoint"
    RESTART="--restart $RUNDIR/checkpoint.npz"
else
    echo "seed $SEED: fresh start"
    cp "$CASE"/*.in "$RUNDIR/"
    sed -i "s/^seed .*/seed ${SEED}/" "$RUNDIR/PARAMETERS.in"
    RESTART=""
fi

python -m kmc3d.run --dir "$RUNDIR" --out "$RUNDIR" $RESTART &
PID=$!
trap 'echo "time limit near: forwarding SIGTERM to python $PID"; kill -TERM $PID' USR1 TERM
wait $PID
STATUS=$?
# `wait` also returns when the trap fires: keep waiting while python is alive
while kill -0 $PID 2>/dev/null; do
    wait $PID
    STATUS=$?
done
echo "kmc3d seed ${SEED} finished with status $STATUS at $(date)"
