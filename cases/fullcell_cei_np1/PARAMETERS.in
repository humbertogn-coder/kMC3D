# MILESTONE 2, series 3: fullcell_cei with a thin cathode (N/P ~ 0.7) and the
# anode-inactive stop. Same kinetics and brakes as fullcell_cei.
seed 8597
temperature 298
saltMolar 1.2
solvMolar 6.5
scanIntervalType time
potentialType step
scanInterval 3600
maxInterval 400
BeginV 4.4
EndV 2.8
totalSteps 100000
maxCycles 200
printStepFreq 1
XYZprintFreq 500
snapshotEveryCycles 20
checkpointEveryCycles 20
globalA 0.5
numberDecompositionRxns 25
nMobilityReactions 3
# ---- Li-S coupling (new) ---------------------------------------------------
li_pool_mode shared
li_pool_init -1
reservoir_sites 2000
# anode bulk foil: -1 = unlimited (framework Li accounted, not capped);
# set N >= 0 to model a finite Li excess (effective N/P ratio)
li_bulk_init -1
# ---- structural brakes (2026-09-21) ----------------------------------------
# li_pool_max: 2 * li_pool0 (74 Li+ in this box) -> mean-field current
# coupling of the two electrodes (no stripping / cathodic oxidation when the
# electrolyte cannot take more Li+). stop_electrolyte_fraction: clean stop
# when ETH+SOL+FSI fall below 5 % of the initial count (cell dried out).
li_pool_max 148
stop_electrolyte_fraction 0.05
stop_anode_inactive_halves 6
